@{
    var age = 10;
    var name = "AA";
}

<div class="text-center">
    <h1 class="display-4">Welcome to MVC by @ViewData["Name"] Experience @ViewBag.Experience</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<table class="table table-bordered table-dark">
    <thead>
        <tr>
            <th>Sr.No</th>
            <th>Name</th>
            <th>Age</th>
        </tr>
    </thead>
    <tbody>
        @for(int i = 0; i < 10; i++)
        {
            <tr>
                <td>@(i+1)</td>
                <td>A</td>
                <td>@(age++)</td>
            </tr>
        }
        
    </tbody>
</table>
 @age
<h1>Sum of 1 & 3 is @(1+3)</h1>
