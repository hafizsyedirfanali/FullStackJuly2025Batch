 @model List<NewsPaper>
@{
    int i = 1;
    var categoryId = (int)ViewBag.CategoryId;//will check
}
<div style="display:flex; justify-content:end;">
    <a class="btn btn-success mb-2 " asp-action="Create" asp-route-categoryId="@categoryId">Add NewsPaper</a>
</div>
@if(Model is null)
{
    <div class="alert alert-danger">Null Data</div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr class="text-black fw-bold">
                <td>Sr No</td>
                <td>NewsPaper Name</td>
                <td>NewsPaper Description</td>
                <td>Action</td>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>
                            <form method="post" asp-action="Delete" asp-route-newsPaperId="@item.Id">
                                <a class="btn btn-primary me-2" asp-action="Update" asp-route-newsPaperId="@item.Id">Update</a>
                                <button type="submit" onclick="return confirm('are you sure you want to delete?')" class="btn btn-danger">Delete</button>
                           </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4">No record found</td>                    
                </tr>
            }
        </tbody>
    </table>

}
 