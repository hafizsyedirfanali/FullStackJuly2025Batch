
@model NewsPaper;
@{
    var categoryId= (int)ViewBag.CategoryId;
}
<div class="container">
    <div class="row ">  
        <h1 class="text-center">Add Newspaper</h1>
        <form method="post" asp-action="Create" asp-controller="NewsPaper">
            <input asp-for="CategoryId" hidden />
            <label class="m-2 text-black fw-bold">NewsPaper Name</label>
        <input type="text" class="form-control" asp-for="Name"/>
            <label class="m-2 text-black fw-bold">NewsPaper Description</label>
        <input type="text" class="form-control" asp-for="Description" />
            <label class="m-2 text-black fw-bold">
                <input type="checkbox" asp-for="IsActive" />Status
            </label>
        
        <div class="text-center">
            <button type="submit" class="btn btn-success mt-2 " style="width:200px">Add</button>
                <a class="btn btn-success mt-2 " asp-action="NewsPapers" asp-route-categoryId="@categoryId">Back</a>
        </div>
      </form>
        </div>
</div>