
@model Book
@{
    var categoryId= (int)ViewBag.CategoryId;
    // Safely retrieve the value using a null-conditional operator.
    //var categoryId = ViewBag.CategoryId as int?;
}
<div class="container">
    <div class="row ">  
        <h1 class="text-center">Add Book</h1>
        <form method="post" asp-action="Create" asp-controller="Book">
            <input asp-for="CategoryId" hidden />
        <label class="m-2 text-black fw-bold">Book Title</label>
        <input type="text" class="form-control" asp-for="Title"/>
        <label class="m-2 text-black fw-bold">Book Description</label>
        <input type="text" class="form-control" asp-for="Description" />
            <label class="m-2 text-black fw-bold">
                <input type="checkbox" asp-for="IsActive" />Status
            </label>
        
        <div class="text-center">
            <button type="submit" class="btn btn-success mt-2 " style="width:200px">Add</button>
                <a class="btn btn-success mt-2 " asp-action="Books" asp-route-categoryId="@(categoryId)">Back</a>
        </div>
      </form>
        </div>
</div>