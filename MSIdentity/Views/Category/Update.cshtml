@model Category

<div class="container">
    <div class="row ">  
        <form method="post" asp-action="Update" asp-controller="Category">
            <input asp-for="Id" hidden />
        <label class="m-2 text-black fw-bold">Category Name</label>
        <input type="text" class="form-control" asp-for="Name"/>
        <label class="m-2 text-black fw-bold">Category Description</label>
        <input type="text" class="form-control" asp-for="Description" />
            <label class="m-2 text-black fw-bold">
                <input type="checkbox" asp-for="IsAction" />Status
            </label>
        
        <div class="text-center">
            <button type="submit" class="btn btn-success mt-2 " style="width:200px">Save Changes</button>
                <a class="btn btn-success mt-2 " asp-action="Categories">Back</a>
        </div>
      </form>
        </div>
</div>