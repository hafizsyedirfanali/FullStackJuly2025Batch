@model Magazine
@{
    var categoryId = (int)ViewBag.CategoryId;
}
<div class="container">
    <div class="row ">
        <form method="post" asp-action="Update" asp-controller="Magazine">
            <input asp-for="Id" hidden />
            <input asp-for="CategoryId" hidden />
            <label class="m-2 text-black fw-bold">Magazine Name</label>
            <input type="text" class="form-control" asp-for="Name" />
            <label class="m-2 text-black fw-bold">Magazine Description</label>
            <input type="text" class="form-control" asp-for="Description" />
            <label class="m-2 text-black fw-bold">
                <input type="checkbox" asp-for="IsActive" />Status
            </label>

            <div class="text-center">
                <button type="submit" class="btn btn-success mt-2 " style="width:200px">Save Changes</button>
                <a class="btn btn-success mt-2 " asp-action="Magazines" asp-route-categoryId="@categoryId">Back</a>
            </div>
        </form>
    </div>
</div>
